/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tuxery-web",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSET",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  /**
   * Custom domains — tuxery.store and www.tuxery.store both serve this
   * same Worker (identical site, no canonical redirect between them).
   * Copied into env.production below rather than left to inherit — Wrangler
   * warns that relying on inheritance here looks like it "reassigns" the
   * domains (even though env.production is the same Worker, so it's a
   * no-op); cleared for env.preview, which only needs its own
   * *.workers.dev preview URL.
   * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
   */
  "routes": [
    { "pattern": "tuxery.store", "custom_domain": true },
    { "pattern": "www.tuxery.store", "custom_domain": true },
  ],
  /**
   * Explicit named environments, both deployed by GitHub Actions
   * (.github/workflows/deploy.yml) — `wrangler deploy --env production` on
   * `main`, `wrangler versions upload --env preview` on other branches.
   * `assets` is non-inheritable in Wrangler and must be redeclared in each;
   * env.production's `name` matches the top-level one on purpose (same
   * Worker, same existing custom domains/secrets) — it's only here so every
   * deploy command in CI can pass an explicit `--env` and never rely on the
   * ambiguous top-level default.
   */
  "env": {
    "production": {
      "name": "tuxery-web",
      "assets": {
        "binding": "ASSET",
        "directory": "./dist",
      },
      "routes": [
        { "pattern": "tuxery.store", "custom_domain": true },
        { "pattern": "www.tuxery.store", "custom_domain": true },
      ],
    },
    "preview": {
      "name": "tuxery-web-preview",
      "assets": {
        "binding": "ASSET",
        "directory": "./dist",
      },
      "routes": [],
    },
  },
  /**
   * Environment Variables
   * TURSO_DB_URL, TURSO_DB_AUTH_TOKEN, UNSPLASH_ACCESS_KEY: set as secrets
   * per environment — `wrangler secret put <NAME> --env production`, but
   * `wrangler versions secret put <NAME> --env preview` for preview
   * specifically (the plain command needs a 100%-traffic deployed
   * version to attach to, which preview never has by design — see the
   * "preview" env entry below and README's Deployment section). Never
   * committed here — see README.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
}
