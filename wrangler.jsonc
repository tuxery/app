/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tuxery-web",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSET",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  /**
   * Custom domains — tuxery.store and www.tuxery.store both reach this
   * Worker; `www.` answers with a 301 to the bare host (src/routes/layout.tsx).
   * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
   */
  "routes": [
    { "pattern": "tuxery.store", "custom_domain": true },
    { "pattern": "www.tuxery.store", "custom_domain": true },
  ],
  /**
   * Worker Previews — every pull request gets its own Preview of this same
   * Worker at <name>.preview.tuxery.store (`wrangler preview` in
   * .github/workflows/deploy.yml; `wrangler deploy` on `main` is
   * production). Previews don't inherit observability, vars or bindings
   * from the settings above, so the ones they need are repeated here. Their secrets (preview-tuxery Turso DB,
   * not prod's) live in the dashboard's Previews Base config — see
   * scripts/push-cloudflare-secrets.sh. This replaced the separate
   * `tuxery-web-preview` Worker on 2026-10-19.
   * https://developers.cloudflare.com/workers/previews/configuration/
   */
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true,
      },
    },
  },
  /**
   * Environment Variables
   * TURSO_DB_URL, TURSO_DB_AUTH_TOKEN, UNSPLASH_ACCESS_KEY: set as secrets,
   * once for production (`wrangler secret put <NAME>`) and once for
   * Previews (`wrangler preview base-config secret put <NAME>`) —
   * scripts/push-cloudflare-secrets.sh does both. Never committed here —
   * see README.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
}
