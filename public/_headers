# https://developers.cloudflare.com/pages/platform/headers/

# Private beta: static files stay out of search engines too (pages get the
# same header from layout.tsx's `onRequest`, see SITE_IS_PUBLIC in src/seo.ts).
/*
  X-Robots-Tag: noindex

/*service-worker.js
  Cache-Control: no-store
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/build/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# The logo sprite keeps its name when logos are added, so it can't be immutable.
/logos.svg
  Cache-Control: public, max-age=3600
