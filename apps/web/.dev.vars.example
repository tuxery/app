# This is documentation, not a template to copy: `.dev.vars` is generated
# automatically by scripts/dev.mjs on every `pnpm dev` run (based on
# whether --remote was passed), so hand edits to `.dev.vars` get
# overwritten on the next run. This file just shows the shape.

# Default (local mode): points at the local `turso dev` server catalog's
# `pnpm serve` runs, fronting its locally-seeded database (run
# `pnpm seed` then `pnpm serve` in tuxery/catalog first). No auth token
# needed for that local server.
TURSO_DB_URL=http://127.0.0.1:8080
TURSO_DB_AUTH_TOKEN=

# `pnpm dev --remote`: points at the real hosted Turso dev DB instead —
# credentials read from /workspaces/.dev/.env (shared with catalog's
# `pnpm seed --remote`), not from this file.
