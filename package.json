{
  "name": "@tuxery/web",
  "private": true,
  "description": "Tuxery — Qwik UI: search-first homepage, unified app cards, category filters",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types --include-runtime=false",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "oxfmt .",
    "fmt.check": "oxfmt --check .",
    "lint": "oxlint src",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "test": "vitest run",
    "test.e2e": "playwright test",
    "test.e2e.degraded": "playwright test --config=playwright.degraded.config.ts",
    "test.e2e.worker": "playwright test --config=playwright.worker.config.ts",
    "typecheck": "tsc --incremental --noEmit",
    "qwik": "qwik"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@qwik-ui/headless": "^0.7.7",
    "@qwikest/icons": "^0.0.13",
    "daisyui": "^5.7.43",
    "helpers4": "^3.1.2"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.1",
    "ignore": "^7.0.9",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.1",
    "wrangler": "^4.131.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
