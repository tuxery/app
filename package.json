{
  "name": "@tuxery/web",
  "private": true,
  "description": "Tuxery — Qwik UI: search-first homepage, unified app cards, category filters",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "oxfmt .",
    "fmt.check": "oxfmt --check .",
    "lint": "oxlint src",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "test": "vitest run",
    "test.e2e": "playwright test",
    "test.e2e.degraded": "playwright test --config=playwright.degraded.config.ts",
    "typecheck": "tsc --incremental --noEmit",
    "qwik": "qwik"
  },
  "dependencies": {
    "@helpers4/array": "^3.0.9",
    "@helpers4/guard": "^3.0.9",
    "@helpers4/map": "^3.0.9",
    "@helpers4/number": "^3.0.9",
    "@helpers4/object": "^3.0.9",
    "@helpers4/promise": "^3.0.9",
    "@helpers4/string": "^3.0.9",
    "@libsql/client": "^0.17.4",
    "@qwik-ui/headless": "^0.7.7",
    "@qwikest/icons": "^0.0.13",
    "daisyui": "^5.7.20"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.0",
    "ignore": "^7.0.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
